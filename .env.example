# Server Port (Render sets this automatically)
PORT=3000

# Google Service Account JSON Content (For Cloud deployments like Render)
# You can paste the entire contents of scoop-plus-b8ec77cef48d.json as a single string
GOOGLE_CREDENTIALS=

# Or specify a file path to the service account credentials JSON (for local use)
GOOGLE_CREDENTIALS_PATH=./scoop-plus-b8ec77cef48d.json
